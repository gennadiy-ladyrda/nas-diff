# Абсолютный путь к корню данных Synology, который монтируется в контейнер как /nas
NAS_MOUNT_PATH=/volume1

# Внутренние каталоги сканирования относительно /nas
# Пример: /nas/photo,/nas/homes/gena/Pictures
NAS_SCAN_ROOTS=/nas/photo,/nas/archive

# Папка карантина/корзины внутри /nas
NAS_TRASH_DIR=/nas/.nas-diff-trash

# По умолчанию безопасный режим: перемещение в корзину
DEFAULT_FILE_ACTION=move_to_trash
HARD_DELETE_ENABLED=false

# Similar mode
PHASH_DISTANCE_THRESHOLD=8
MAX_SCAN_WORKERS=2

# Backend / worker runtime
APP_NAME=nas-diff
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////data/nas_diff.db
REDIS_URL=redis://redis:6379/0
WORKER_QUEUES=scan_queue,action_queue
